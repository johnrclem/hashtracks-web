    <style>
    html {
  --version: 26.0801_03; /*underscore gets replaced by dot to fix issue with iPad/Safari*/
  --white4dark: antiquewhite;
  --darkBackground: #222;
  --darkHeadText: limegreen;
  --darkInvert: invert(1);
  --darkOddRows: wheat;
  font-family: Verdana, Deja Vu Sans, Segoi UI, Arial, sans-serif;
  --lnkButtonDecoration: #307090;
  }
h1.pageTitle {
  color: blueviolet;
  text-align: center;
  font-weight: normal;
  margin-top: auto;
  margin-bottom: auto;
  }
#hareHounds {
  position: absolute;
  width: 400px;
  height: 140px;
  top: 0.5em;
  right: 30px;
  z-index: -5;
  background-image: url('/images/drinkingClub.png');
  background-repeat: no-repeat;
  background-position: right;
  }
#content {
  background-color: #eeeee0;
  }
footer {
  margin-top: 1.0em;
  text-align: center;
  clear: both;
  color: black;
  font-weight: normal;
  font-size: 0.8em;
  }
.html5badge {
  vertical-align: middle;
  height: 20px;
  margin-top: 0.5em;
  }
.black {
  color: black;
  }
.blue {
  color: blue;
  }
.red {
  color: red;
  }
.green {
  color: darkgreen;
  }
.strike {
  text-decoration: line-through;
  }
.smiley {
  font-size: 150%;
  }
.centred {
  text-align: center;
  }
.justify {
  text-align: justify;
  }
.break {
  clear: both;
  }
.lnkButton {
  display: inline-flex;
  background-color: lightskyblue;
  border-radius: 10px;
  padding: 0.3em;
  border: solid 1px var(--lnkButtonDecoration);
  box-shadow: 3px 2px 0px var(--lnkButtonDecoration);
  }
.lnkButton--small {
  border-radius: 8px;
  padding-top: 0.25em;
  padding-bottom: 0.25em;
  }
.lnkButton__lnk {
  font-size: 0.8em;
  font-weight: bold;
  color: maroon;
  text-decoration: none;
  }
.lnkButton__lnk--small {
  font-size: 0.9em;
  }
.lnkButton:hover {
  box-shadow: 1px 2px 0px var(--lnkButtonDecoration);
  opacity: 0.7;
  }
.lnkButton__lnk:hover {
  color: gold;
  }
@media only screen and (max-width: 1023px) {
  #hareHounds {
    display: none;
    }
  .lnkButton__lnk--small {
    font-size: 1.1em;
    }
}
@media (prefers-color-scheme: dark) {
  #content {
    background-color: var(--darkBackground);
    }
  h1.pageTitle {
    filter: var(--darkInvert);
    }
  #hareHounds {
    background-image: url('/images/dark-drinkingClub.png');
    }
  footer {
    color: var(--white4dark);
    }
  footer a {
    color: gold;
    }
}#menuBurger {
  position: absolute;
  top: 0.1em;
  left: 0.1em;
  color: blueviolet;
  font-size: 3em;
  line-height: 0.5em;
  z-index: 4;
  }
#menuWrapper {
   position: absolute;
   height: auto;
   top: 0.5em;
   left: 0.5em;
   z-index: 5;
   border: solid orange 2px;
   background-image: linear-gradient(to right, #3366ff, firebrick);
   }
#menuBar {
   margin: 0;
   padding: 0;
   }
menu li {
   list-style: none;
   float: left;
   }
menu a, menu #fontPlus {
   display: block;
   padding: 0.3em 0.8em;
   color: yellow;
   font-size: 0.8em;
   text-decoration: none;
   }
#fontPlus>#fontImg {
    max-height: 1.3em;
    }
menu li menu {
   display: none;
   }
menu li:hover menu {
   position: absolute;
   display: inherit;
   list-style: none;
   margin-left: -3.0em;
   }
menu menu li {
   float: none;
   }
menu menu a {
   border: 1px solid orange;
   border-top: 0;
   color: white;
   font-size: 0.75em;
   text-align: center;
   background-color: firebrick;
   background-image: linear-gradient(to right, #3366ff, #70b0f0);
   }
menu menu a:hover {
   color: black;
   }
@media only screen and (max-width: 1024px) {
  #menuWrapper {
    top: 0.2em;
    left: 0.2em;
    }
  menu a {
    font-size: 0.95em;
    }
  menu menu a {
    font-size: 0.9em;
    }
  }#fTableMain {
  width: auto;
  margin: 1em auto auto auto;
  clear: both;
  }
#fTableMain .title {
  background-color: lightskyblue;
  color: navy;
  font-size: 1.1em;
  font-weight: bold;
  text-align: center;
  }
#fTable {
  min-width: 100%;
  border: solid silver 2px;
  border-collapse: collapse;
  }
#fTable .inf {
  font-size: 0.8em;
  background-color: #f0f0f0;
  }
#fTable .inf .ldiv {
  width: 25%;
  }
#fTable .inf .mdiv {
  width: 42%;
  }
#fTableHead th {
  background-color: plum;
  height: auto;
  color: black;
  font-size: 0.9em;
  font-weight: bold;
  text-transform: capitalize;
  border: solid silver 1px;
  padding: 0.3em;
  }
#fTableHead td, #fTableMain .title {
  border: solid silver 1px;
  border-bottom: 0;
  padding: 0.3em;
  }
#fTableHead .flt_row {
  background-color: azure;
  }
#fTableHead .flt_row .filters {
  width: 100%;
  width: -moz-available;
  width: -webkit-fill-available;
  width: fill-available;
  background-color: lightyellow;
  }
#fTableBody {
  background-color: white;
  font-size: 0.9em;
  }
#fTableBody tr.odd {
  background-color: lightsteelblue;
  }
#fTableBody td {
  border: none;
  padding: 0.3em;
  word-break: break-word;
  }
@media only screen and (-webkit-max-device-width: 810px), 
       only screen and (max-device-width: 810px) {
  #fTable .inf {
    font-size: 0.7em;
    }
  #fTable .inf .ldiv {
    width: 17%;
    }
  #fTable .inf .mdiv {
    width: 48%;
    }
  #fTable .inf .rdiv {
    width: 35%;
    }
  .pubCell {
    margin: 0;
    padding-bottom: 0.5em;
    }
  .lnkButton__lnk--small {
    font-size: 0.9em;
    }
  }
@media (prefers-color-scheme: dark) {
  #fTableBody {
    background-color: var(--white4dark);
    }
  #fTableBody tr.odd {
    background-color: var(--darkOddRows);
    }
  #fTableBody tr.even {
    background-color: var(--white4dark);
    }
  }
    #fTableMain {
      max-width: 1024px;
      }
    #fTableBody td {
      word-break: normal;
      }
    .yearBeer {
      color: mediumaquamarine;
      font-size: 1.2em;
      margin-left: 2em;
      }
    .yearBeer img {
      float: left;
      margin: 0 0.5em 0.5em 0;
      vertical-align: top;
      }  
    .warning {
      text-align: center;
      font-size: 0.8em;
      color: red;
      margin-top: 1.0em;
      margin-bottom: 1.0em;
      }
    #allRuns {
      display: block;
      width: fit-content;
      margin-left: auto;
      margin-right: auto;
      }
    @media only screen and (max-width: 1023px) {
      .lnkButton__lnk--small {
        font-size: 0.9em;
        }
    @media only screen and (max-width: 810px) {
      #fTableHead th:first-child {
        min-width: 100px;
        }
      .yearBeer img {
        max-height: 100px;
        }
      }
    @media only screen and (max-width: 767px) {
      #allRuns {
        display: none;
        }
      }
    }
    </style>
  </head>

