</div>
<script>
  doc = document;
  mb = doc.querySelector('#menuBurger');
  mw = doc.querySelector('#menuWrapper');
// browser default top margin is 8px
  const defTop = 8;
  const fontSizes = ['initial', 'large', 'x-large', 'xx-large'];
  hh = null;
  newFontsize = 0;
//
  function hasTouch() {
    return (('ontouchstart' in window) || (navigator.maxTouchPoints > 0));
  }
  function useBurgerMenu() {
    return (hasTouch() && window.innerWidth < 1024);
  }
// leave space for menu bar or the 'drinking club' image if present
  function setBodyMarginTop() {
    hh = document.querySelector('#hareHounds');
    mwBorder = parseInt(getComputedStyle(mw).getPropertyValue('border-top-width'),10) + parseInt(getComputedStyle(mw).getPropertyValue('border-bottom-width'),10);
    ht = ((hh == null) || (getComputedStyle(hh).getPropertyValue('display') == 'none')) ? mw.clientHeight + mwBorder : hh.clientHeight;
    bodyMarginTop = ht + defTop;
    mw.parentElement.style.marginTop = bodyMarginTop + 'px';
  }
// initial condition
  function initBodyMarginTop() {
    setBodyMarginTop();
    if (useBurgerMenu()) menuOut();
  }
// menu fly-in
  function menuIn() {
    mw.style.visibility = 'visible';
    mw.style.transform = 'translate(0,0)';
    if (useBurgerMenu()) mw.parentElement.style.marginTop = bodyMarginTop + 'px';
  }
// menu fly-out
  function menuOut() {
    mw.style.transform = 'translate(-500px,0)';
    if((hh == null) || (getComputedStyle(hh).getPropertyValue('display') == 'none')) mw.parentElement.style.marginTop = defTop + 'px';
  }

// create touch event handlers to show/hide the menu bar
  if (useBurgerMenu()) {
    mw.parentElement.style.transition = 'margin-top 0.75s linear';
    mw.style.transition = 'transform 1s';
    mw.style.visibility = 'hidden';
    menuOut();
    mb.innerHTML = '&equiv;';
    mb.addEventListener('touchstart', menuIn);
    window.addEventListener('touchstart', function(e) {
      if((mb !== e.target) && (!mw.contains(e.target))) menuOut();
    })
  }
  else {
    mw.style.visibility = 'visible';
  }
// zoom font size for user accessibility
  var evType = hasTouch() ? 'touchstart' : 'click';
  doc.querySelector('#fontPlus').addEventListener(evType, function() {
    this.ownerDocument.body.style.fontSize = fontSizes[++newFontsize % 4];
  });
// on initial page load calc the required top margin
  window.addEventListener('load', initBodyMarginTop);
</script>
